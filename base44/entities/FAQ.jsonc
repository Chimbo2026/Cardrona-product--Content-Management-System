{
  "name": "FAQ",
  "type": "object",
  "properties": {
    "question_zh": {
      "type": "string"
    },
    "question_en": {
      "type": "string"
    },
    "answer_zh": {
      "type": "string"
    },
    "answer_en": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u8d2d\u7968",
        "\u96ea\u573a",
        "\u4ea4\u901a",
        "\u652f\u4ed8",
        "\u4ee3\u7406"
      ]
    },
    "sort_order": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "question_zh",
    "answer_zh"
  ]
}
{
  "name": "RetailOrder",
  "type": "object",
  "properties": {
    "order_no": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "name_zh": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "agent_code": {
      "type": "string"
    },
    "agent_rate": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NZD"
    },
    "shipping_method": {
      "type": "string",
      "enum": [
        "\u987a\u4e30\u56fd\u9645\u76f4\u90ae",
        "\u65b0\u897f\u5170\u9152\u5e97\u914d\u9001",
        "\u95e8\u5e97\u81ea\u63d0"
      ]
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "shipping_address": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "wechat_pay",
        "card",
        "gift_card"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refund_pending",
        "refunded"
      ],
      "default": "unpaid"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "confirmed",
        "shipped",
        "cancelled"
      ],
      "default": "pending_payment"
    },
    "source": {
      "type": "string",
      "enum": [
        "\u5fae\u4fe1\u641c\u7d22",
        "\u670b\u53cb\u5708\u5206\u4eab",
        "\u4ee3\u7406\u63a8\u8350",
        "\u5c0f\u7a0b\u5e8f\u7801",
        "\u5e7f\u544a\u6295\u653e"
      ]
    },
    "shopify_order_ref": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "order_no",
    "total_amount"
  ]
}
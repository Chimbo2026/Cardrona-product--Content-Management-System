{
  "name": "DiningVenue",
  "description": "On-mountain restaurant, cafe or bar with photo, location, hours and offering",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "venue_type": {
      "type": "string",
      "enum": [
        "Restaurant",
        "Cafe",
        "Bar"
      ],
      "default": "Restaurant"
    },
    "mountain": {
      "type": "string",
      "enum": [
        "Cardrona",
        "Treble Cone"
      ],
      "default": "Cardrona"
    },
    "location": {
      "type": "string"
    },
    "opening_hours": {
      "type": "string"
    },
    "offering": {
      "type": "string",
      "description": "Short summary of what the venue serves, e.g. Asian fusion, pizza, barista coffee"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Photo of the restaurant or cafe shown on the dining board"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Seasonal",
        "Closed"
      ],
      "default": "Open"
    },
    "menu_url": {
      "type": "string"
    },
    "booking_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "venue_type",
    "mountain",
    "status"
  ]
}
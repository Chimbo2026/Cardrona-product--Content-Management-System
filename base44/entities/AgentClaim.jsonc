{
  "name": "AgentClaim",
  "type": "object",
  "properties": {
    "agent_email": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "agent_code": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NZD"
    },
    "booking_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "paid"
      ],
      "default": "requested"
    },
    "requested_at": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "agent_email",
    "amount"
  ]
}
{
  "name": "ShopItem",
  "type": "object",
  "properties": {
    "name_zh": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u7537\u58eb",
        "\u5973\u58eb",
        "\u914d\u4ef6"
      ]
    },
    "price": {
      "type": "number",
      "description": "NZD \u552e\u4ef7"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_new": {
      "type": "boolean",
      "default": false
    },
    "image_url": {
      "type": "string"
    },
    "summary_zh": {
      "type": "string"
    },
    "summary_en": {
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name_zh",
    "category",
    "price"
  ]
}
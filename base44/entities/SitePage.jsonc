{
  "name": "SitePage",
  "description": "Editable website page managed from the Website Builder: home page, product pages and campaign landing pages",
  "type": "object",
  "properties": {
    "page_type": {
      "type": "string",
      "enum": [
        "Home",
        "Product",
        "Campaign"
      ],
      "description": "Which part of the website this page belongs to"
    },
    "title": {
      "type": "string",
      "description": "Page or campaign name shown in the builder"
    },
    "slug": {
      "type": "string",
      "description": "URL slug used by the public site, e.g. early-bird-season-pass"
    },
    "hero_title": {
      "type": "string"
    },
    "hero_subtitle": {
      "type": "string"
    },
    "hero_image_url": {
      "type": "string"
    },
    "body_text": {
      "type": "string",
      "description": "Main copy; line breaks render as separate paragraphs"
    },
    "promo_text": {
      "type": "string",
      "description": "Short promotional callout shown under the body copy"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Published"
      ],
      "default": "Draft"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "page_type",
    "title",
    "status"
  ]
}
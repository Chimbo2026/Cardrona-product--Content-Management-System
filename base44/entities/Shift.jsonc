{
  "name": "Shift",
  "description": "Scheduled staff shift on the weekly roster",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "hours": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "Clocked In",
        "Late",
        "Completed",
        "Absent",
        "Cancelled"
      ],
      "default": "Scheduled"
    },
    "clock_in": {
      "type": "string"
    },
    "clock_out": {
      "type": "string"
    },
    "shift_label": {
      "type": "string",
      "enum": [
        "Morning",
        "Afternoon",
        "Evening"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "staff_name",
    "date",
    "start_time",
    "end_time",
    "department",
    "status"
  ]
}
{
  "name": "ContentItem",
  "description": "Website content record managed from the Content Management CMS",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "Products",
        "Translations",
        "FAQs",
        "Mountain Information"
      ]
    },
    "key": {
      "type": "string",
      "description": "Translation key, e.g. home.hero.title"
    },
    "title": {
      "type": "string"
    },
    "title_zh": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "body_zh": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Published",
        "Draft",
        "Archived"
      ],
      "default": "Draft"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "section",
    "title",
    "status"
  ]
}
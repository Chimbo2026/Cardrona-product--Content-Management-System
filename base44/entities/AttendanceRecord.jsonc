{
  "name": "AttendanceRecord",
  "description": "Clock-in and clock-out record for a staff shift",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "shift_id": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "clock_in": {
      "type": "string"
    },
    "clock_out": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Clocked In",
        "Completed",
        "Late",
        "Absent"
      ],
      "default": "Clocked In"
    },
    "minutes_late": {
      "type": "number",
      "default": 0
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "staff_name",
    "date",
    "status"
  ]
}
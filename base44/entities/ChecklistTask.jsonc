{
  "name": "ChecklistTask",
  "description": "Demo daily opening or closing checklist task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "enum": [
        "Opening",
        "Closing"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "completed_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "section",
    "date",
    "completed"
  ]
}
{
  "name": "Booking",
  "type": "object",
  "properties": {
    "order_no": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_category": {
      "type": "string"
    },
    "visit_date": {
      "type": "string"
    },
    "visit_end_date": {
      "type": "string",
      "description": "\u884c\u7a0b\u7ed3\u675f\u65e5\u671f\uff0c\u5355\u65e5\u9884\u8ba2\u4e0e visit_date \u76f8\u540c"
    },
    "quantity": {
      "type": "number"
    },
    "unit_price": {
      "type": "number"
    },
    "subtotal": {
      "type": "number"
    },
    "discount_code": {
      "type": "string"
    },
    "discount_amount": {
      "type": "number"
    },
    "total_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "NZD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "confirmed",
        "used",
        "reschedule_requested",
        "refund_requested",
        "refunded",
        "cancelled"
      ],
      "default": "pending_payment"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "wechat_pay",
        "card",
        "agent_transfer"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refund_pending",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_ref": {
      "type": "string"
    },
    "payment_plan": {
      "type": "string",
      "enum": [
        "now",
        "later"
      ],
      "default": "now",
      "description": "\u5b63\u7968\u4ed8\u6b3e\u65b9\u6848\uff1a\u7acb\u5373\u652f\u4ed8 / \u5148\u4eab\u540e\u4ed8"
    },
    "deposit_amount": {
      "type": "number",
      "description": "\u5148\u4eab\u540e\u4ed8\u65f6\u4eca\u65e5\u53ea\u6536\u53d6\u7684\u5b9a\u91d1"
    },
    "pass_type": {
      "type": "string",
      "enum": [
        "saver",
        "unlimited",
        "summer"
      ],
      "description": "\u5b63\u7968\u7c7b\u578b"
    },
    "pass_type_label": {
      "type": "string"
    },
    "age_band": {
      "type": "string",
      "enum": [
        "adult",
        "child",
        "senior",
        "under6",
        "over75"
      ]
    },
    "age_band_label": {
      "type": "string"
    },
    "agent_email": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "\u5fae\u4fe1\u641c\u7d22",
        "\u670b\u53cb\u5708\u5206\u4eab",
        "\u4ee3\u7406\u63a8\u8350",
        "\u5c0f\u7a0b\u5e8f\u7801",
        "\u5e7f\u544a\u6295\u653e"
      ]
    },
    "guest_name_pinyin": {
      "type": "string"
    },
    "guest_legal_name": {
      "type": "string"
    },
    "guest_dob": {
      "type": "string"
    },
    "guest_nationality": {
      "type": "string"
    },
    "guest_document_no": {
      "type": "string"
    },
    "guest_phone": {
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "extra_guests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name_pinyin": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          },
          "dob": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          }
        }
      }
    },
    "waiver_signed": {
      "type": "boolean",
      "default": false
    },
    "waiver_signature": {
      "type": "string"
    },
    "waiver_signature_file": {
      "type": "string"
    },
    "waiver_signed_at": {
      "type": "string"
    },
    "aspenware_sync_status": {
      "type": "string",
      "enum": [
        "not_connected",
        "pending",
        "synced",
        "failed"
      ],
      "default": "not_connected"
    },
    "aspenware_order_ref": {
      "type": "string"
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "order_no",
    "product_name",
    "total_amount"
  ]
}